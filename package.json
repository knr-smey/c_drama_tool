{
  "name": "c_drama_tool",
  "version": "1.0.0",
  "description": "KhmerDubStudio - AI Video Dubbing Desktop Application in Next.js & Electron",
  "main": "electron/main.js",
  "scripts": {
    "dev:next": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev": "cross-env NODE_ENV=development concurrently -k -n \"NEXT,DESKTOP\" -c \"cyan,magenta\" \"npm run dev:next\" \"npm run dev:electron\"",
    "build": "next build",
    "start": "next start",
    "desktop": "cross-env NODE_ENV=production electron .",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "app": "npm run dev"
  },
  "build": {
    "appId": "com.khmerdubstudio.desktop",
    "productName": "KhmerDubStudio",
    "mac": {
      "category": "public.app-category.video",
      "target": ["dir"]
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "package.json"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knr-smey/c_drama_tool.git"
  },
  "keywords": [
    "khmer-dubbing",
    "ai-dubbing",
    "nextjs",
    "electron",
    "whisper",
    "edge-tts",
    "ffmpeg"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "lucide-react": "^0.460.0",
    "next": "^14.2.15",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "wait-on": "^8.0.1"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  }
}
